# Copy to .env and fill in. Never commit real values.
POSTGRES_PASSWORD=change-me
# 32 random bytes in base64: openssl rand -base64 32
NITIDA_SIGNING_KEK=
# Optional, only while rotating: the previous 32-byte key and the version it was sealed under.
# NITIDA_SIGNING_KEK_PREVIOUS=
# NITIDA_SIGNING_KEK_PREVIOUS_VERSION=1
# NITIDA_SIGNING_KEK_VERSION=2
# Set to false only for plain-http local runs
NITIDA_COOKIE_SECURE=true
# Optional, dev profile only: creates the development data (see README). Empty = no seed. Min 12 characters.
NITIDA_DEV_SEED_PASSWORD=
# Password of the database role the application connects as (it owns no tables, so row-level security applies). Different from POSTGRES_PASSWORD.
NITIDA_APP_DB_PASSWORD=
